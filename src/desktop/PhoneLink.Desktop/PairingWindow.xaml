<Window x:Class="PhoneLink.Desktop.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配对新手机"
        Width="440" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="用手机扫描此二维码"
                   FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Text="保持手机与电脑在同一局域网，打开 Phone-Link 点击「配对新手机」并扫码。"
                   Foreground="#666666" TextWrapping="Wrap" Margin="0,8,0,0"/>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,16"
                Padding="16"
                VerticalAlignment="Stretch">
            <Grid>
                <Image Source="{Binding QrImage}"
                       Stretch="Uniform"
                       Margin="8"
                       Visibility="{Binding QrImage, Converter={StaticResource NonNullToVisible}}"/>
                <TextBlock Text="{Binding ErrorText}"
                           Foreground="#C62828"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorText, Converter={StaticResource NonEmptyToVisible}}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3">
            <TextBlock Text="{Binding ExpiryText}"
                       Foreground="#666666" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding SessionId}"
                       Foreground="#AAAAAA" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <Button Content="关闭" Width="120" HorizontalAlignment="Center" Margin="0,12,0,0"
                    Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>