<Window x:Class="PhoneLink.Desktop.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配对新手机"
        Icon="/Assets/app.ico"
        FontFamily="{StaticResource AppFont}"
        Width="440" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="用手机扫描此二维码" Style="{StaticResource SectionText}"
                   HorizontalAlignment="Center"/>

        <TextBlock Grid.Row="1" Text="保持手机与电脑在同一局域网，打开 Phone-Link 点击「配对新手机」并扫码。"
                   Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Margin="0,8,0,0"
                   HorizontalAlignment="Center" TextAlignment="Center"/>

        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Margin="16,18,16,14"
                Padding="20"
                VerticalAlignment="Stretch">
            <Grid>
                <Image Source="{Binding QrImage}"
                       Stretch="Uniform"
                       Margin="4"
                       Visibility="{Binding QrImage, Converter={StaticResource NonNullToVisible}}"/>
                <TextBlock Text="{Binding ErrorText}"
                           Foreground="{StaticResource DangerBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="{Binding ErrorText, Converter={StaticResource NonEmptyToVisible}}"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3">
            <TextBlock Text="{Binding ExpiryText}"
                       Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding SessionId}"
                       Style="{StaticResource SecondaryText}" HorizontalAlignment="Center"
                       Margin="0,4,0,0" FontSize="11"/>
            <Button Content="关闭" Style="{StaticResource SecondaryButtonStyle}" Width="120"
                    HorizontalAlignment="Center" Margin="0,16,0,0"
                    Click="OnCloseClick"/>
        </StackPanel>
    </Grid>
</Window>