<Application x:Class="PhoneLink.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PhoneLink.Desktop.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <converters:NullOrEmptyToVisibleConverter x:Key="NullOrEmptyToVisible"/>
        <converters:NonEmptyToVisibleConverter x:Key="NonEmptyToVisible"/>
    </Application.Resources>
</Application>