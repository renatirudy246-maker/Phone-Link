<Window x:Class="PhoneLink.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Phone-Link"
        Width="760" Height="520"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Phone-Link" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="  ·  Phase 1" FontSize="16" Foreground="#999999"
                       VerticalAlignment="Bottom" Margin="8,0,0,4"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding StatusLine}"
                   Foreground="#666666" Margin="0,8,0,0" FontSize="13"/>

        <Border Grid.Row="2"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,12"
                VerticalAlignment="Stretch">
            <Grid>
                <TextBlock Text="尚未收到图片"
                           Foreground="#AAAAAA"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding LatestImagePath, Converter={StaticResource NullOrEmptyToVisible}}"/>
                <Image Source="{Binding LatestImagePath}"
                       Stretch="Uniform"
                       Margin="8"
                       Visibility="{Binding LatestImagePath, Converter={StaticResource NonEmptyToVisible}}"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,4,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Recent" FontWeight="SemiBold" Margin="0,4,0,6"/>
            <ListBox Grid.Row="1"
                     ItemsSource="{Binding Recent}"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,3">
                            <TextBlock Text="{Binding TimeLabel}" Foreground="#888888" Width="64"/>
                            <TextBlock Text="{Binding FileName}" Foreground="#333333" Width="220"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusLabel}" Foreground="#4CAF50"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</Window>