<Window x:Class="PhoneLink.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Phone-Link"
        Icon="pack://siteoforigin:,,,/Assets/app.ico"
        FontFamily="{StaticResource AppFont}"
        Width="1120" Height="760"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: title + live status | pause + device -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Phone-Link" Style="{StaticResource TitleText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding StatusDotColor}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusLine}" Style="{StaticResource BodyText}"/>
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" Margin="0,0,10,0" Click="OnTogglePauseClick">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                        <Setter Property="Content" Value="暂停接收"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                <Setter Property="Content" Value="恢复接收"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Grid.Column="2" Content="设备" Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0" Click="OnManageDevicesClick"/>
            <Button Grid.Column="3" Content="＋ 配对新手机" Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnPairNewPhoneClick"/>
        </Grid>

        <!-- Latest image: dominant visual area -->
        <Border Grid.Row="1"
                Background="{StaticResource ImageSurfaceBrush}"
                CornerRadius="14"
                ClipToBounds="True"
                MouseLeftButtonDown="OnLatestImageDoubleClick">
            <Grid>
                <TextBlock Text="手机内容会自动出现在这里"
                           Foreground="#B0ACA4"
                           FontSize="15"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding LatestImagePath, Converter={StaticResource NullOrEmptyToVisible}}"/>
                <Image x:Name="LatestImage" Source="{Binding LatestImagePath}"
                       Stretch="Uniform" Margin="16"
                       Visibility="{Binding LatestImagePath, Converter={StaticResource NonEmptyToVisible}}"/>
            </Grid>
        </Border>

        <!-- Actions + current device summary -->
        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="复制图片" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,8,0"
                        Visibility="{Binding LatestImagePath, Converter={StaticResource NonEmptyToVisible}}"
                        Click="OnCopyLatestClick"/>
                <Button Content="打开" Style="{StaticResource SecondaryButtonStyle}"
                        Margin="0,0,8,0"
                        Visibility="{Binding LatestImagePath, Converter={StaticResource NonEmptyToVisible}}"
                        Click="OnOpenLatestClick"/>
                <Button Content="文件夹" Style="{StaticResource SecondaryButtonStyle}"
                        Visibility="{Binding LatestImagePath, Converter={StaticResource NonEmptyToVisible}}"
                        Click="OnOpenFolderClick"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource GhostButtonStyle}"
                    Padding="10,6" Click="OnManageDevicesClick">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                        <Ellipse.Fill>
                            <SolidColorBrush Color="{Binding CurrentDevice.StatusColor, FallbackValue=#9CA3AF}"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <TextBlock Text="{Binding CurrentDevice.DisplayName, FallbackValue=等待手机连接}"
                               Style="{StaticResource BodyText}"
                               FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Recent: horizontal filmstrip with external bottom slider -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="最近接收" Style="{StaticResource SectionText}" Margin="0,0,0,8"/>
            <ListBox x:Name="RecentListBox" Grid.Row="1"
                     ItemsSource="{Binding Recent}"
                     SelectedItem="{Binding SelectedRecent, Mode=TwoWay}"
                     ItemContainerStyle="{StaticResource FilmstripItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="False"
                     Height="128"
                     SelectionChanged="OnRecentSelectionChanged"
                     PreviewMouseWheel="OnFilmstripPreviewMouseWheel"
                     ScrollViewer.PanningMode="HorizontalOnly">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="132">
                            <Border Width="116" Height="80" CornerRadius="8"
                                    Background="#FFFFFF" BorderBrush="#E5E7EB" BorderThickness="1"
                                    ClipToBounds="True">
                                <Image Source="{Binding LocalFilePath}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{Binding TimeLabel}" Style="{StaticResource SecondaryText}"
                                       FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Slider x:Name="RecentPositionSlider" Grid.Row="2" Orientation="Horizontal"
                    Style="{StaticResource FilmstripSliderStyle}"
                    Margin="0,8,0,0"
                    Minimum="0" Maximum="1" Value="0"
                    Visibility="Collapsed"
                    ValueChanged="OnFilmstripSliderValueChanged"/>
        </Grid>
    </Grid>
</Window>