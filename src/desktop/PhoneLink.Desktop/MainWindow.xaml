<Window x:Class="PhoneLink.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhoneLink.Desktop"
        mc:Ignorable="d"
        Title="Phone-Link"
        Width="720" Height="480"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Phone-Link"
                       FontSize="28" FontWeight="SemiBold"/>
            <TextBlock Text="{Binding StatusLine}"
                       Foreground="Gray" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#F5F5F5"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="8"
                Margin="0,16"
                VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="📷 手机拍下题目，电脑自动收到"
                           FontSize="16" Foreground="#444444"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Phase 0 · 最小主窗口"
                           FontSize="12" Foreground="#888888" Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="{Binding DeviceId}"
                       Foreground="#AAAAAA" FontSize="11"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>