<Window x:Class="PhoneLink.Desktop.DeviceManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="设备管理 - Phone-Link"
        FontFamily="{StaticResource AppFont}"
        Width="640" Height="520"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="已配对设备" Style="{StaticResource TitleText}" Margin="0,0,0,14"/>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Devices}"
                 ItemContainerStyle="{StaticResource PlainListBoxItemStyle}"
                 BorderThickness="0">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0">
                            <DockPanel>
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/>
                                <Ellipse Width="8" Height="8" Margin="8,0,0,0"
                                         VerticalAlignment="Center">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding StatusColor}"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusLabel}" Foreground="#4B5563"
                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <TextBlock Foreground="#9CA3AF" FontSize="12" Margin="0,4,0,0"
                                       Text="{Binding DeviceId, StringFormat=设备 ID：{0}}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding Platform}" Foreground="#9CA3AF" FontSize="12" Width="90"/>
                                <TextBlock Text="{Binding LastSeenLabel, StringFormat=最近在线：{0}}"
                                           Foreground="#9CA3AF" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="撤销信任" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,5" Margin="0,0,6,0"
                                    Visibility="{Binding IsTrusted, Converter={StaticResource BoolToVisible}}"
                                    Click="OnRevokeClick"
                                    Tag="{Binding DeviceId}"/>
                            <Button Content="恢复信任" Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="10,5" Margin="0,0,6,0"
                                    Visibility="{Binding IsTrusted, Converter={StaticResource InverseBoolToVisible}}"
                                    Click="OnRestoreClick"
                                    Tag="{Binding DeviceId}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="2" Content="关闭" Style="{StaticResource PrimaryButtonStyle}"
                HorizontalAlignment="Right" Margin="0,16,0,0" Click="OnCloseClick"/>
    </Grid>
</Window>